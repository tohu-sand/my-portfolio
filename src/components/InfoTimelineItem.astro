---
import { render, type CollectionEntry } from "astro:content";
import { getDatePartsUTC } from "../utils/date";
import { getEventStatus, type EventStatus } from "../utils/info";
import InfoCategoryBadge from "./InfoCategoryBadge.astro";
import InfoStatusBadge from "./InfoStatusBadge.astro";
import InfoLink from "./InfoLink.astro";
import InfoLocation from "./InfoLocation.astro";

interface Props {
  entry: CollectionEntry<"info">;
  id?: string;
  today: Date;
}

const { entry, id, today } = Astro.props;
const { data } = entry;
const parts = getDatePartsUTC(data.date);
const status: EventStatus | null =
  data.category === "Event" ? getEventStatus(data.date, today) : null;
const isActive = status === "upcoming" || status === "today";
const hasBody = (entry.body ?? "").trim().length > 0;
const rendered = hasBody ? await render(entry) : null;
const Content = rendered?.Content;
---
<li id={id} class="group grid scroll-mt-24 grid-cols-[3.5rem_1fr] gap-x-3 sm:grid-cols-[4.5rem_1fr] sm:gap-x-4">
  <time datetime={parts.iso} class="flex flex-col items-center pt-1 leading-none text-stone-900 dark:text-stone-100">
    <span class="sr-only">{parts.year}年{parts.month}月{parts.day}日（{parts.weekday}）</span>
    <span aria-hidden="true" class="text-xs font-medium text-stone-500 dark:text-stone-400">{parts.month}月</span>
    <span aria-hidden="true" class="mt-1 text-2xl font-bold tabular-nums sm:text-3xl">{parts.day}</span>
    <span aria-hidden="true" class="mt-1 text-xs text-stone-500 dark:text-stone-400">{parts.weekday}</span>
  </time>

  <div class="relative border-l border-stone-200 pb-8 pl-5 group-last:pb-0 dark:border-stone-700 sm:pl-7">
    <span
      aria-hidden="true"
      class={`absolute left-[-5px] top-2.5 h-[9px] w-[9px] rounded-full ring-4 ring-stone-50 dark:ring-stone-900 ${
        isActive ? "bg-(--accent)" : "bg-stone-300 dark:bg-stone-600"
      }`}
    ></span>

    <article
      class={`rounded-xl border bg-white p-4 shadow-xs dark:bg-stone-800 sm:p-5 ${
        isActive
          ? "border-orange-300 dark:border-orange-400/50"
          : "border-stone-200 dark:border-stone-700"
      }`}
    >
      <div class="flex flex-wrap items-center gap-2">
        <InfoCategoryBadge category={data.category} />
        {status && <InfoStatusBadge status={status} />}
      </div>

      <h4 class="mt-2 text-lg font-semibold text-stone-900 dark:text-stone-100">{data.title}</h4>

      {data.location && (
        <InfoLocation category={data.category} location={data.location} class="mt-1" />
      )}

      {hasBody && Content ? (
        <div class="mt-3 text-sm leading-relaxed text-stone-700 dark:text-stone-300 [&_p]:m-0 [&_a]:font-medium [&_a]:text-(--accent) [&_a:hover]:underline">
          <Content />
        </div>
      ) : (
        data.description && (
          <p class="mt-3 text-sm leading-relaxed text-stone-700 dark:text-stone-300">{data.description}</p>
        )
      )}

      {data.url && (
        <div class="mt-4">
          <InfoLink url={data.url} />
        </div>
      )}
    </article>
  </div>
</li>
