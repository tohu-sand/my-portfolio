---
import { render, type CollectionEntry } from "astro:content";
import { formatDateJP } from "../utils/date";
import InfoCategoryBadge from "./InfoCategoryBadge.astro";
import InfoLink from "./InfoLink.astro";
import InfoLocation from "./InfoLocation.astro";

interface Props {
  entry: CollectionEntry<"info">;
  id?: string;
}

const { entry, id } = Astro.props;
const { data } = entry;
const dateStr = formatDateJP(data.date);
const hasBody = (entry.body ?? "").trim().length > 0;
const rendered = hasBody ? await render(entry) : null;
const Content = rendered?.Content;
---
<article id={id} class="scroll-mt-24 rounded-xl border border-stone-700 bg-stone-800 p-4 shadow-xs">
  <div class="flex flex-wrap items-center gap-2">
    <InfoCategoryBadge category={data.category} />
    <time datetime={data.date.toISOString().slice(0, 10)} class="text-sm text-stone-400">{dateStr}</time>
  </div>

  <h3 class="mt-2 text-lg font-semibold text-stone-100">{data.title}</h3>

  {data.location && (
    <InfoLocation category={data.category} location={data.location} class="mt-1" />
  )}

  {hasBody && Content ? (
    <div class="mt-3 text-sm leading-relaxed text-stone-300 [&_p]:m-0 [&_a]:font-medium [&_a]:text-(--accent) [&_a:hover]:underline">
      <Content />
    </div>
  ) : (
    data.description && <p class="mt-3 text-sm leading-relaxed text-stone-300">{data.description}</p>
  )}

  {data.url && (
    <div class="mt-4">
      <InfoLink url={data.url} />
    </div>
  )}
</article>
