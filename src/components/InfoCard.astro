---
import { render, type CollectionEntry } from "astro:content";
import { formatDateJP } from "../utils/date";
import InfoCategoryBadge from "./InfoCategoryBadge.astro";
import InfoLink from "./InfoLink.astro";
import InfoLocation from "./InfoLocation.astro";

interface Props {
  entry: CollectionEntry<"info">;
}

const { entry } = Astro.props;
const { data } = entry;
const dateStr = formatDateJP(data.date);
const hasBody = (entry.body ?? "").trim().length > 0;
const rendered = hasBody ? await render(entry) : null;
const Content = rendered?.Content;
---
{/* data-categoryでアクセント色が変わる */}
<article data-category={data.category} class="relative rounded-xl border border-stone-700 bg-stone-800 p-4 shadow-xs transition-colors hover:border-(--accent)/50">
  <div class="flex flex-wrap items-center gap-2">
    <InfoCategoryBadge category={data.category} />
    <time datetime={data.date.toISOString().slice(0, 10)} class="text-sm text-stone-400">{dateStr}</time>
  </div>

  <h3 class="mt-2 text-lg font-semibold text-stone-100">
    {/* after要素でカード全体をリンクにする。中のリンクはz-10で上に出す */}
    <a href={`/info/#${entry.id}`} class="after:absolute after:inset-0 after:rounded-xl">{data.title}</a>
  </h3>

  {data.location && (
    <InfoLocation category={data.category} location={data.location} class="mt-1" />
  )}

  {hasBody && Content ? (
    <div class="mt-3 text-sm leading-relaxed text-stone-300 [&_p]:m-0 [&_a]:relative [&_a]:z-10 [&_a]:font-medium [&_a]:text-(--accent) [&_a:hover]:underline">
      <Content />
    </div>
  ) : (
    data.description && <p class="mt-3 text-sm leading-relaxed text-stone-300">{data.description}</p>
  )}

  {data.url && (
    <div class="mt-4 [&>a]:relative [&>a]:z-10">
      <InfoLink url={data.url} />
    </div>
  )}
</article>
