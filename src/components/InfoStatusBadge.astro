---
import { getStatusLabel, type EventStatus } from "../utils/info";

interface Props {
  status: EventStatus;
  category: string;
  class?: string;
}

const { status, category, class: className = "" } = Astro.props;

const label = getStatusLabel(category, status);

const activeClasses: Record<string, string> = {
  Event: "bg-(--accent) text-(--accent-contrast)",
  Publication: "bg-(--accent-2) text-stone-950",
};

const classes =
  status === "past"
    ? "bg-stone-800 text-stone-400 ring-1 ring-inset ring-stone-700"
    : (activeClasses[category] ?? activeClasses.Event);
---
{label && (
  <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${classes} ${className}`}>
    {label}
  </span>
)}
