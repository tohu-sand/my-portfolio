---
import { Icon } from "astro-icon/components";

interface Props {
  category: string;
  class?: string;
}

const { category, class: className = "" } = Astro.props;

const styles: Record<string, { icon: string; classes: string }> = {
  Event: {
    icon: "lucide:calendar",
    classes:
      "bg-(--accent)/15 text-(--accent-hover) ring-(--accent)/30",
  },
  Publication: {
    icon: "lucide:book-open",
    classes:
      "bg-(--accent-2)/15 text-(--accent-2-hover) ring-(--accent-2)/30",
  },
};

const style = styles[category] ?? {
  icon: "lucide:tag",
  classes:
    "bg-stone-700 text-stone-300 ring-stone-600",
};
---
<span
  class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${style.classes} ${className}`}
>
  <Icon name={style.icon} class="h-3.5 w-3.5" aria-hidden="true" />
  {category}
</span>
