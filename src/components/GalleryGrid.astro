---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import GalleryItem from "./GalleryItem.astro";
import { GALLERY_KINDS, getGalleryKind, getGalleryKindLabel } from "../utils/gallery";

interface Props {
  artworks: CollectionEntry<"gallery">[];
}

const { artworks } = Astro.props as Props;

const kindCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();
for (const art of artworks) {
  const kind = getGalleryKind(art.data);
  kindCounts.set(kind, (kindCounts.get(kind) ?? 0) + 1);
  for (const tag of art.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const kinds = GALLERY_KINDS.filter((kind) => (kindCounts.get(kind) ?? 0) > 0);
const showKindFilter = kinds.length > 1;

// 作品数の多い順、同数なら名前順
const tags = [...tagCounts.keys()].sort(
  (a, b) => tagCounts.get(b)! - tagCounts.get(a)! || a.localeCompare(b, "ja")
);

const hasFilters = showKindFilter || tags.length > 0;

// 選択中は白背景なのでホバー色は未選択だけ
const segmentClass =
  "cursor-pointer rounded-md px-3 py-1 text-sm text-stone-400 transition-colors not-aria-pressed:hover:text-stone-100 aria-pressed:bg-stone-100 aria-pressed:text-stone-900 disabled:pointer-events-none disabled:opacity-40";
const chipClass =
  "group inline-flex shrink-0 cursor-pointer items-center gap-1 whitespace-nowrap rounded-full border border-stone-700 px-3 py-1 text-sm text-stone-300 transition-colors not-aria-pressed:hover:border-stone-500 not-aria-pressed:hover:text-stone-100 aria-pressed:border-stone-100 aria-pressed:bg-stone-100 aria-pressed:text-stone-900 disabled:pointer-events-none disabled:opacity-40";
const resetClass = "cursor-pointer underline underline-offset-2 transition-colors hover:text-stone-100";
---
<div data-gallery>
  {hasFilters && (
    <div class="mb-6">
      <button
        type="button"
        data-gallery-toggle
        aria-expanded="false"
        aria-controls="gallery-filter-panel"
        class="flex cursor-pointer items-center gap-1.5 text-sm text-stone-400 transition-colors hover:text-stone-100"
      >
        <Icon name="lucide:sliders-horizontal" class="h-4 w-4" aria-hidden="true" />
        絞り込み
        <Icon name="lucide:chevron-down" class="h-4 w-4 transition-transform" data-gallery-chevron aria-hidden="true" />
      </button>
      <p class="sr-only" aria-live="polite"><span data-gallery-count>{artworks.length}</span>件</p>

      <div id="gallery-filter-panel" data-gallery-panel class="mt-3 flex flex-col gap-3" hidden>
        {showKindFilter && (
          <div role="group" aria-label="種類" class="inline-flex self-start rounded-lg bg-stone-800 p-1">
            <button type="button" class={segmentClass} data-kind="" aria-pressed="true">すべて</button>
            {kinds.map((kind) => (
              <button type="button" class={segmentClass} data-kind={kind} aria-pressed="false">
                {getGalleryKindLabel(kind)}
              </button>
            ))}
          </div>
        )}
        {/* スマホは1行で横スクロール */}
        {tags.length > 0 && (
          <div
            role="group"
            aria-label="タグ"
            data-gallery-tags
            class="relative -mx-4 flex items-center gap-2 overflow-x-auto px-4 py-1 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:py-0"
          >
            <Icon name="lucide:tag" class="h-4 w-4 shrink-0 text-stone-500" aria-hidden="true" />
            {tags.map((tag) => (
              <button type="button" class={chipClass} data-tag={tag} aria-pressed="false">
                {tag}
                <span class="hidden text-xs tabular-nums opacity-60 sm:inline" data-count>{tagCounts.get(tag)}</span>
                <Icon name="lucide:x" class="hidden h-3.5 w-3.5 group-aria-pressed:inline" aria-hidden="true" />
              </button>
            ))}
          </div>
        )}
      </div>
    </div>
  )}

  <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-gallery-grid>
    {artworks.map((art: CollectionEntry<"gallery">, index: number) => (
      <div
        class="h-full"
        data-gallery-item
        data-kind={getGalleryKind(art.data)}
        data-tags={JSON.stringify(art.data.tags ?? [])}
      >
        <GalleryItem entry={art} priority={index === 0} />
      </div>
    ))}
  </section>

  <p class="mt-8 text-center text-stone-400" data-gallery-empty hidden>
    該当する作品はありません。
    <button type="button" data-gallery-reset class={`ml-2 ${resetClass}`}>絞り込みを解除</button>
  </p>
</div>

<script>
  interface Item {
    el: HTMLElement;
    kind: string;
    tags: string[];
  }

  const root = document.querySelector<HTMLElement>("[data-gallery]");
  const grid = root?.querySelector<HTMLElement>("[data-gallery-grid]");
  const emptyMessage = root?.querySelector<HTMLElement>("[data-gallery-empty]");
  const countLabel = root?.querySelector<HTMLElement>("[data-gallery-count]");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-gallery-toggle]");
  const panel = root?.querySelector<HTMLElement>("[data-gallery-panel]");

  if (root && grid && emptyMessage && countLabel && toggle && panel) {
    const items: Item[] = Array.from(grid.querySelectorAll<HTMLElement>("[data-gallery-item]")).map(
      (el) => ({
        el,
        kind: el.dataset.kind ?? "",
        tags: JSON.parse(el.dataset.tags ?? "[]"),
      })
    );
    // data-kindは作品カードにもあるのでボタンだけ拾う
    const kindButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-kind]"));
    const tagButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-tag]"));
    const tagRow = root.querySelector<HTMLElement>("[data-gallery-tags]");
    const chevron = root.querySelector<HTMLElement>("[data-gallery-chevron]");
    const resetButton = root.querySelector<HTMLButtonElement>("[data-gallery-reset]");

    const matchesKind = (item: Item, kind: string) => !kind || item.kind === kind;
    const matchesTag = (item: Item, tag: string) => !tag || item.tags.includes(tag);

    // URLのクエリから初期状態を復元
    const params = new URLSearchParams(location.search);
    const pick = (value: string | null, allowed: string[]) =>
      value && allowed.includes(value) ? value : "";
    const state = {
      kind: pick(params.get("kind"), kindButtons.map((b) => b.dataset.kind ?? "")),
      tag: pick(params.get("tag"), tagButtons.map((b) => b.dataset.tag ?? "")),
    };

    const updateOption = (button: HTMLButtonElement, count: number, pressed: boolean) => {
      button.setAttribute("aria-pressed", String(pressed));
      // 0件の選択肢は押せなくする（選択中は除く）
      button.disabled = count === 0 && !pressed;
      const countEl = button.querySelector<HTMLElement>("[data-count]");
      if (countEl) countEl.textContent = String(count);
    };

    // 選択中のタグが見える位置まで横にスクロール
    const revealActiveTag = () => {
      const button = tagButtons.find((b) => b.dataset.tag === state.tag);
      if (!button || !tagRow || panel.hidden) return;
      const pad = 16;
      const start = button.offsetLeft;
      const end = start + button.offsetWidth;
      const viewStart = tagRow.scrollLeft;
      const viewEnd = viewStart + tagRow.clientWidth;
      if (start < viewStart + pad) tagRow.scrollLeft = start - pad;
      else if (end > viewEnd - pad) tagRow.scrollLeft = end - tagRow.clientWidth + pad;
    };

    const setExpanded = (expanded: boolean) => {
      panel.hidden = !expanded;
      toggle.setAttribute("aria-expanded", String(expanded));
      chevron?.classList.toggle("rotate-180", expanded);
      if (expanded) revealActiveTag();
    };

    const render = () => {
      let visible = 0;
      for (const item of items) {
        const show = matchesKind(item, state.kind) && matchesTag(item, state.tag);
        item.el.hidden = !show;
        if (show) visible++;
      }
      emptyMessage.hidden = visible > 0;
      countLabel.textContent = String(visible);

      for (const button of kindButtons) {
        const kind = button.dataset.kind ?? "";
        const count = items.filter((i) => matchesKind(i, kind) && matchesTag(i, state.tag)).length;
        updateOption(button, count, kind === state.kind);
      }
      for (const button of tagButtons) {
        const tag = button.dataset.tag ?? "";
        const count = items.filter((i) => matchesKind(i, state.kind) && matchesTag(i, tag)).length;
        updateOption(button, count, tag === state.tag);
      }
      revealActiveTag();

      const url = new URL(location.href);
      const setParam = (key: string, value: string) =>
        value ? url.searchParams.set(key, value) : url.searchParams.delete(key);
      setParam("kind", state.kind);
      setParam("tag", state.tag);
      history.replaceState(null, "", url);
    };

    toggle.addEventListener("click", () => setExpanded(panel.hidden));
    for (const button of kindButtons) {
      button.addEventListener("click", () => {
        state.kind = button.dataset.kind ?? "";
        render();
      });
    }
    for (const button of tagButtons) {
      button.addEventListener("click", () => {
        const tag = button.dataset.tag ?? "";
        // 選択中のタグをもう一度押すと解除
        state.tag = state.tag === tag ? "" : tag;
        render();
      });
    }
    resetButton?.addEventListener("click", () => {
      state.kind = "";
      state.tag = "";
      render();
    });

    render();
  }
</script>
