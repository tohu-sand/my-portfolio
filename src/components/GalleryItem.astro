---
import type { CollectionEntry } from "astro:content";
import { formatDateJP } from "../utils/date";
import { getGalleryKind, getGalleryKindLabel, type GalleryKind } from "../utils/gallery";

interface Props {
  entry: CollectionEntry<"gallery">;
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const { data } = entry;
const dateStr = formatDateJP(data.date);
const kind = getGalleryKind(data);
const kindLabel = getGalleryKindLabel(kind);

const accentClass: Record<GalleryKind, string> = {
  illustration: "border-(--accent)",
  comic: "border-(--accent-2)",
};
---
<figure class="group h-full">
  <a href={`/gallery/${entry.id}/`} class="flex h-full flex-col rounded-xl border border-stone-700 overflow-hidden bg-stone-800 shadow-sm transition-shadow hover:shadow-lg shadow-stone-900/50 hover:shadow-stone-900/70">
    <div class="relative h-48 overflow-hidden">
      <img
        src={data.thumbnail}
        alt={data.title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
        decoding="async"
      />
      <span class="absolute inset-0 bg-black/30 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
    </div>
    <figcaption class={`flex flex-col border-t-4 p-4 text-sm leading-tight ${accentClass[kind]}`}>
      <span class="line-clamp-2 font-medium text-stone-100">{data.title}</span>
      <time datetime={data.date.toISOString()} class="mt-1 text-xs text-stone-400">
        {dateStr}・{kindLabel}
      </time>
    </figcaption>
  </a>
</figure>
