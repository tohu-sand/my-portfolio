---
import { getCollection } from "astro:content";
import InfoCard from "../components/InfoCard.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import { compareByDateDesc } from "../utils/date";
import { getTodayUTC, isPublishedInfo } from "../utils/info";
import { person, serializeJsonLd } from "../utils/jsonLd";

const today = getTodayUTC();
const thirtyDaysAgo = getTodayUTC();
thirtyDaysAgo.setUTCDate(thirtyDaysAgo.getUTCDate() - 30);

const infos = await getCollection("info", (entry: CollectionEntry<"info">) => {
  if (!isPublishedInfo(entry)) {
    return false;
  }
  const { data } = entry;
  if (data.category === "Event" && data.date < today) {
    return false;
  }
  return data.date >= thirtyDaysAgo;
});
const sortedInfos = infos.sort(compareByDateDesc);

const posts = await getCollection("posts");
const gallery = await getCollection("gallery");
const allPosts = [...posts, ...gallery];
const latestPost = allPosts.sort(compareByDateDesc)[0];

const heroImageUrl = "https://cdn.tohu-sand.com/illust/web/shijohikyaku_medium.webp";
const heroImageAlt = "漫画「試場飛脚」表紙イラスト";
const heroImageYear = 2026;

// 構造化データの準備
const heroImageStructuredData = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "name": heroImageAlt,
  "url": "https://tohu-sand.com/",
  "contentUrl": heroImageUrl,
  "license": "https://tohu-sand.com/policy/",
  "acquireLicensePage": "https://tohu-sand.com/contact/",
  "creditText": "豆腐さんど",
  "copyrightNotice": `© ${heroImageYear} 豆腐さんど`,
  "creator": person
};
---

<BaseLayout
  title="hasamiyacco"
  description="豆腐さんどのホームページです。漫画やイラストなどを公開しています。"
  adsense
>
  <script type="application/ld+json" set:html={serializeJsonLd(heroImageStructuredData)}></script>
  <h1 class="sr-only">hasamiyacco - 豆腐さんどのホームページ</h1>
  <div class="flex justify-center mb-8">
    <img
      src={heroImageUrl}
      alt={heroImageAlt}
      width="1425"
      height="1998"
      class="w-full max-w-xl h-auto rounded-lg shadow-lg object-cover"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <h2 class="text-2xl font-bold mb-4 text-stone-100">About</h2>
  <p class="text-stone-300 mb-6 ">
    <strong>豆腐さんど(@tohu_sand)</strong><br />
    趣味で漫画・イラストを描いています。自主制作漫画誌展示即売会 コミティアにて同人サークル「ロボット技術研究会」を主宰しています。
  </p>

  <h2 class="text-2xl font-bold mt-10 mb-4 text-stone-100">Upcoming Info</h2>
  <div class="space-y-4">
    {sortedInfos.length
      ? sortedInfos.map((e) => <InfoCard entry={e} />)
      : <p class="text-stone-400">現在お知らせはありません。</p>}
  </div>

  <h2 class="text-2xl font-bold mt-10 mb-4 text-stone-100">Recent Post</h2>
  {latestPost
    ? <PostCard entry={latestPost} />
    : <p class="text-stone-400">まだブログ記事がありません。</p>}
</BaseLayout>
