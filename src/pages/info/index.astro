---
import { getCollection, type CollectionEntry } from "astro:content";
import InfoTimelineItem from "../../components/InfoTimelineItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { groupByYearDesc } from "../../utils/date";
import { getTodayUTC } from "../../utils/info";
import { entryToSlug } from "../../utils/slug";

const pageDescription = "豆腐さんどのお知らせページです。イベント参加や掲載などの情報を掲載しています。";

const infos = await getCollection("info", () => true);
const infosByYear = groupByYearDesc(infos);
const today = getTodayUTC();
---
<BaseLayout
  title="hasamiyacco | お知らせ"
  description={pageDescription}
  ogTitle="hasamiyacco | お知らせ"
  ogDescription={pageDescription}
  ogUrl="https://tohu-sand.com/info/"
>
  <div class="mx-auto max-w-3xl">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-stone-900 dark:text-stone-100">Information</h2>
      <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">イベント参加・掲載などのお知らせです。</p>
    </div>

    <div class="space-y-12">
      {infosByYear.map(([year, entries]) => (
        <section aria-labelledby={`info-year-${year}`}>
          <h3
            id={`info-year-${year}`}
            class="mb-6 flex items-center gap-4 text-sm font-semibold tracking-widest text-stone-500 dark:text-stone-400"
          >
            <span>{year}</span>
            <span class="h-px flex-1 bg-stone-200 dark:bg-stone-700" aria-hidden="true"></span>
          </h3>
          <ol class="list-none">
            {entries.map((e: CollectionEntry<"info">) => (
              <InfoTimelineItem entry={e} id={entryToSlug(e)} today={today} />
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
