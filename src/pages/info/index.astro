---
import { getCollection, type CollectionEntry } from "astro:content";
import InfoTimelineItem from "../../components/InfoTimelineItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { groupByYearDesc } from "../../utils/date";
import { getTodayUTC, isPublishedInfo } from "../../utils/info";

const pageDescription = "イベント参加・掲載などのお知らせです。";

const infos = await getCollection("info", isPublishedInfo);
const infosByYear = groupByYearDesc(infos);
const today = getTodayUTC();
---
<BaseLayout
  title="hasamiyacco | お知らせ"
  description={pageDescription}
>
  <div class="mx-auto max-w-3xl">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-stone-100">Information</h1>
      <p class="mt-1 text-sm text-stone-400">{pageDescription}</p>
    </div>

    <div class="space-y-12">
      {infosByYear.map(([year, entries]) => (
        <section aria-labelledby={`info-year-${year}`}>
          <h3
            id={`info-year-${year}`}
            class="mb-6 flex items-center gap-4 text-sm font-semibold tracking-widest text-stone-400"
          >
            <span>{year}</span>
            <span class="h-px flex-1 bg-stone-700"></span>
          </h3>
          <ol class="list-none">
            {entries.map((e: CollectionEntry<"info">) => (
              <InfoTimelineItem entry={e} id={e.id} today={today} />
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
