---
import { getCollection, type CollectionEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDateJP } from "../../utils/date";
import { person, serializeJsonLd } from "../../utils/jsonLd";

type PostEntry = CollectionEntry<"posts">;

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post: PostEntry) => ({
    params: { slug: post.id },
    props: { entry: post },
  }));
}

const { entry } = Astro.props as { entry: PostEntry };
const { Content } = await render(entry);
const { data } = entry;
const dateStr = formatDateJP(data.date);
const description = data.excerpt ?? "";
const postUrl = `https://tohu-sand.com/blog/${entry.id}/`;

// 構造化データの準備
const imageStructuredData = {
  "@type": "ImageObject",
  "url": postUrl,
  "contentUrl": data.thumbnail,
  "license": "https://tohu-sand.com/policy/",
  "acquireLicensePage": "https://tohu-sand.com/contact/",
  "creator": person,
  "creditText": "豆腐さんど",
  "copyrightNotice": `© ${data.date.getFullYear()} 豆腐さんど`
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": data.title,
  "description": data.excerpt,
  "image": imageStructuredData,
  "datePublished": data.date.toISOString().split('T')[0],
  "author": person,
  "url": postUrl,
  "mainEntityOfPage": postUrl
};
---
<BaseLayout 
  title={`hasamiyacco | ${data.title}`}
  description={description}
  ogTitle={data.title}
  ogImage={data.thumbnail}
  twitterCard="summary_large_image"
  twitterImageAlt={data.title}
>
  <script type="application/ld+json" set:html={serializeJsonLd(structuredData)}></script>
  
  <article class="prose prose-invert mx-auto prose-a:text-(--accent) hover:prose-a:text-(--accent)">
    <h1>{data.title}</h1>
    <p class="text-sm text-stone-400">{dateStr}</p>

    <img
      src={data.thumbnail}
      alt={data.title}
      width={data.thumbnailWidth}
      height={data.thumbnailHeight}
      class="not-prose w-full h-auto rounded-lg my-4"
      fetchpriority="high"
      decoding="async"
    />

    {data.excerpt && <p class="italic">{data.excerpt}</p>}

    <Content />
  </article>
</BaseLayout>
