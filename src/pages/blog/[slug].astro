---
import { getCollection, type CollectionEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entryToSlug } from "../../utils/slug";
import { formatDateJP } from "../../utils/date";
import { serializeJsonLd } from "../../utils/jsonLd";

type PostEntry = CollectionEntry<"posts">;

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post: PostEntry) => ({
    params: { slug: entryToSlug(post) },
    props: { entry: post },
  }));
}
export const prerender = true;

const { entry } = Astro.props as { entry: PostEntry };
const { Content } = await render(entry);
const { data } = entry;
const slug = entryToSlug(entry);
const dateStr = formatDateJP(data.date);
const description = data.excerpt || `豆腐さんどのブログ「${data.title}」`;
const postUrl = `https://tohu-sand.com/blog/${slug}/`;

// 構造化データの準備
// contentUrl = 画像ファイル、url = その画像を掲載しているページ (schema.org / Google の定義)
const imageStructuredData = {
  "@type": "ImageObject",
  "url": postUrl,
  "contentUrl": data.thumbnail,
  "license": "https://tohu-sand.com/policy/",
  "acquireLicensePage": "https://tohu-sand.com/contact/",
  "creator": {
    "@type": "Person",
    "@id": "https://tohu-sand.com/#person",
    "name": "豆腐さんど",
    "url": "https://tohu-sand.com/"
  },
  "creditText": "豆腐さんど",
  "copyrightNotice": `© ${data.date.getFullYear()} 豆腐さんど`
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": data.title,
  "description": description,
  "image": imageStructuredData,
  "datePublished": data.date.toISOString().split('T')[0],
  "dateModified": data.date.toISOString().split('T')[0],
  "author": {
    "@type": "Person",
    "@id": "https://tohu-sand.com/#person",
    "name": "豆腐さんど",
    "url": "https://tohu-sand.com/"
  },
  "publisher": {
    "@type": "Person",
    "@id": "https://tohu-sand.com/#person",
    "name": "豆腐さんど",
    "url": "https://tohu-sand.com/"
  },
  "url": postUrl,
  "mainEntityOfPage": postUrl
};
---
<BaseLayout 
  title={`hasamiyacco | ${data.title}`}
  description={description}
  ogTitle={data.title}
  ogDescription={description}
  ogUrl={postUrl}
  ogImage={data.thumbnail}
  twitterCard="summary_large_image"
  twitterTitle={`hasamiyacco | ${data.title}`}
  twitterImageAlt={`${data.title} - 豆腐さんどのブログ記事のサムネイル画像`}
>
  <script type="application/ld+json" set:html={serializeJsonLd(structuredData)}></script>
  
  <article class="prose prose-invert mx-auto prose-a:text-(--accent) hover:prose-a:text-(--accent)">
    <h1>{data.title}</h1>
  <p class="text-sm text-stone-400">{dateStr}</p>

    <img
      src={data.thumbnail}
      alt={data.title}
      width={data.thumbnailWidth}
      height={data.thumbnailHeight}
      class="not-prose w-full h-auto rounded-lg my-4"
      fetchpriority="high"
      decoding="async"
    />

    {data.excerpt && <p class="italic">{data.excerpt}</p>}

    <Content />
  </article>
</BaseLayout>
