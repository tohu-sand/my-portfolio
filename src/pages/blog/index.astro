---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { compareByDateDesc } from "../../utils/date";
import { person, serializeJsonLd } from "../../utils/jsonLd";

const posts = await getCollection("posts");
const sortedPosts = posts.sort(compareByDateDesc);

const pageDescription = "豆腐さんどのブログです。";

// 構造化データの準備
const blogPostsStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "hasamiyacco | ブログ",
  "description": pageDescription,
  "url": "https://tohu-sand.com/blog/",
  "author": person,
  "blogPost": sortedPosts.map((post: CollectionEntry<'posts'>) => {
    return {
      "@type": "BlogPosting",
      "headline": post.data.title,
      "datePublished": post.data.date.toISOString().split('T')[0],
      "author": person,
      "url": `https://tohu-sand.com/blog/${post.id}/`,
      "image": {
        "@type": "ImageObject",
        "url": `https://tohu-sand.com/blog/${post.id}/`,
        "contentUrl": post.data.thumbnail,
        "license": "https://tohu-sand.com/policy/",
        "acquireLicensePage": "https://tohu-sand.com/contact/",
        "creator": person,
        "creditText": "豆腐さんど",
        "copyrightNotice": `© ${post.data.date.getFullYear()} 豆腐さんど`
      }
    };
  })
};
---
<BaseLayout 
  title="hasamiyacco | ブログ"
  description={pageDescription}
>
  <script type="application/ld+json" set:html={serializeJsonLd(blogPostsStructuredData)}></script>
  
  <h1 class="text-2xl font-bold mb-6 text-stone-100">Blog</h1>
  <div class="grid md:grid-cols-2 gap-6">
    {sortedPosts.map((p: CollectionEntry<'posts'>) => <PostCard entry={p} />)}
  </div>
</BaseLayout>
