---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import { getCollection } from "astro:content";
import { compareByDateDesc } from "../../utils/date";
import { entryToSlug } from "../../utils/slug";
import { serializeJsonLd } from "../../utils/jsonLd";

const artworks = (await getCollection("gallery")).slice().sort(compareByDateDesc);

// ページ説明文
const pageDescription = "豆腐さんどのイラスト・漫画ギャラリーページです。オリジナル作品を公開しています。";

// 構造化データの準備。作品は画像ファイルではなく作品ページの一覧 (ItemList) として出す。
// 画像ごとの ImageObject は各作品ページ側にあり、ここに原寸 URL を並べない
const galleryStructuredData = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "hasamiyacco | ギャラリー",
  "description": pageDescription,
  "url": "https://tohu-sand.com/gallery/",
  "inLanguage": "ja",
  "author": {
    "@type": "Person",
    "@id": "https://tohu-sand.com/#person",
    "name": "豆腐さんど",
    "url": "https://tohu-sand.com/"
  },
  "license": "https://tohu-sand.com/policy/",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": artworks.length,
    "itemListElement": artworks.map((artwork, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": artwork.data.title,
      "url": `https://tohu-sand.com/gallery/${entryToSlug(artwork)}/`
    }))
  }
};
---

<BaseLayout 
  title="hasamiyacco | ギャラリー"
  description={pageDescription}
  ogTitle="hasamiyacco | ギャラリー"
  ogDescription={pageDescription}
  ogUrl="https://tohu-sand.com/gallery/"
>
  <script type="application/ld+json" set:html={serializeJsonLd(galleryStructuredData)}></script>
  
  <h1 class="text-2xl font-bold mb-6 text-stone-100">Gallery</h1>
  <GalleryGrid artworks={artworks} />
</BaseLayout>
