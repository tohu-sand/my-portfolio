---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import { getCollection } from "astro:content";
import { compareByDateDesc } from "../../utils/date";
import { person, serializeJsonLd } from "../../utils/jsonLd";

const artworks = (await getCollection("gallery")).sort(compareByDateDesc);

// ページ説明文
const pageDescription = "豆腐さんどのイラスト・漫画ギャラリーページです。";

// 構造化データの準備
const galleryStructuredData = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "hasamiyacco | ギャラリー",
  "description": pageDescription,
  "url": "https://tohu-sand.com/gallery/",
  "inLanguage": "ja",
  "author": person,
  "license": "https://tohu-sand.com/policy/",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": artworks.length,
    "itemListElement": artworks.map((artwork, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": artwork.data.title,
      "url": `https://tohu-sand.com/gallery/${artwork.id}/`
    }))
  }
};
---

<BaseLayout 
  title="hasamiyacco | ギャラリー"
  description={pageDescription}
>
  <script type="application/ld+json" set:html={serializeJsonLd(galleryStructuredData)}></script>
  
  <h1 class="text-2xl font-bold mb-6 text-stone-100">Gallery</h1>
  <GalleryGrid artworks={artworks} />
</BaseLayout>
