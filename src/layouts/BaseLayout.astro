---
import "../styles/global.css";
import "@fontsource-variable/noto-sans-jp";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import { serializeJsonLd } from "../utils/jsonLd";
const { 
  title = "Site Title", 
  description = "hasamiyacco - 豆腐さんどのホームページ",
  ogTitle,
  ogDescription,
  ogImage = "https://cdn.tohu-sand.com/illust/card.png",
  ogUrl,
  twitterCard = "summary",
  twitterTitle,
  twitterImageAlt = "hasamiyacco - 豆腐さんどのホームページ画像",
  robots,
  adsense = false,
  turnstile = false
} = Astro.props;

// デフォルトのOGタイトルとディスクリプション、Twitterタイトルを設定
const finalOgTitle = ogTitle || title;
const finalOgDescription = ogDescription || description;
const finalTwitterTitle = twitterTitle || finalOgTitle;
const fallbackUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const finalOgUrl = ogUrl || fallbackUrl;
// AI 学習拒否シグナル (noai / noimageai) を全ページに付与し、ページ個別の robots 指定とマージする。
// AI 検索・回答での引用は許可する方針なので、nosnippet / max-snippet / noarchive / nocache は付けない。
const finalRobots = robots ? `${robots}, noai, noimageai` : "noai, noimageai";

// サイト共通の実体情報 (WebSite / Person / Organization)。各ページの JSON-LD は @id でこの Person を参照する
const siteGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://tohu-sand.com/#website",
      "url": "https://tohu-sand.com/",
      "name": "hasamiyacco",
      "inLanguage": "ja",
      "publisher": { "@id": "https://tohu-sand.com/#person" }
    },
    {
      "@type": "Person",
      "@id": "https://tohu-sand.com/#person",
      "name": "豆腐さんど",
      "alternateName": ["tohu_sand"],
      "url": "https://tohu-sand.com/",
      "description": "趣味で漫画・イラストを描いています。コミティアで同人サークル「ロボット技術研究会」を主宰しています。",
      "memberOf": { "@id": "https://tohu-sand.com/#circle" },
      "sameAs": [
        "https://bsky.app/profile/tohu-sand.com",
        "https://twitter.com/tohu_sand",
        "https://www.pixiv.net/users/65836171",
        "https://www.instagram.com/tohu_sand/",
        "https://fedibird.com/@tohu_sand",
        "https://pawoo.net/@tohu_sand",
        "https://github.com/tohu-sand"
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://tohu-sand.com/#circle",
      "name": "ロボット技術研究会",
      "url": "https://portal.circle.ms/Circle/Index/10492982",
      "founder": { "@id": "https://tohu-sand.com/#person" }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={finalOgUrl} />
    <!-- CDN は crossorigin 属性のない <img> で参照するだけなので、preconnect にも crossorigin を付けない
         （付けると別の接続プールに張られ、画像の取得に再利用されない） -->
    <link rel="preconnect" href="https://cdn.tohu-sand.com" />
    <meta name="robots" content={finalRobots} />
    <meta name="Hatena::Bookmark" content="nocomment" />
    <script type="application/ld+json" set:html={serializeJsonLd(siteGraph)}></script>
    
    <!-- Begin Social Card Metadata -->
    <!-- Open Graph (used by Bluesky, Facebook, LINE etc.) -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={finalOgUrl}>
    <meta property="og:title" content={finalOgTitle}>
    <meta property="og:description" content={finalOgDescription}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:locale" content="ja_JP">

    <!-- Twitter Card -->
    <meta name="twitter:card" content={twitterCard}>
    <meta name="twitter:site" content="@tohu_sand">
    <meta name="twitter:creator" content="@tohu_sand">
    <meta name="twitter:title" content={finalTwitterTitle}>
    <meta name="twitter:description" content={finalOgDescription}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={twitterImageAlt}>
    <!-- End Social Card Metadata -->

    <!-- RSS Feeds -->
    <link rel="alternate" type="application/rss+xml" title="hasamiyacco: ブログ" href={`${Astro.site}rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="hasamiyacco: お知らせ" href={`${Astro.site}info/rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="hasamiyacco: ギャラリー" href={`${Astro.site}gallery/rss.xml`} />

    {adsense && (
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4367665159115458"
        crossorigin="anonymous"
      ></script>
    )}
    {turnstile && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <style>
      html {
        overflow-y: scroll;
      }
      :root {
        --accent: #fb923c;
        --accent-hover: #fdba74;
        --accent-contrast: #1a0f05;
        /* Publication / 漫画用の第2アクセント。favicon の緑 (#93b65f) の彩度を少し上げたもの */
        --accent-2: #8eb947;
        --accent-2-hover: #b5d489;
      }
      /*
        Publication のカード（data-category を持つ要素）の中では、リンク・枠線・タイムラインの点など
        共通の --accent を使う要素をまとめて第2アクセントに切り替える。
        カテゴリを知っているバッジは --accent-2 を直接参照しているので、この差し替えに依存しない。
      */
      :global([data-category="Publication"]) {
        --accent: var(--accent-2);
        --accent-hover: var(--accent-2-hover);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col font-display bg-stone-900 text-stone-100">
    <NavBar />
    <main class="flex-1 container mx-auto p-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>
